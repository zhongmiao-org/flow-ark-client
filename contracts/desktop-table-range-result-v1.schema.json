{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DesktopTableRangeResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cells",
    "shapeVerified",
    "allBlank",
    "matchesExpected"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 200,
        "items": {
          "type": "string"
        }
      }
    },
    "shapeVerified": {
      "const": true
    },
    "allBlank": {
      "type": "boolean"
    },
    "matchesExpected": {
      "enum": [
        true,
        null
      ]
    }
  }
}
