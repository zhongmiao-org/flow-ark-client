      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "plan"
              }
            }
          },
          "then": {
            "properties": {
              "flow": {
                "$ref": "#/$defs/FlowDefinition"
              },
              "questions": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "flow": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "clarify"
              }
            }
          },
          "then": {
            "properties": {
              "questions": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unsupported"
              }
            }
          },
          "then": {
            "properties": {
              "questions": {
                "maxItems": 0
              },
              "limitations": {
                "minItems": 1
              }
            }
          }
        }
      ]
