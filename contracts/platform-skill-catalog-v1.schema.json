{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bundled platform authoring Skill catalog v1 (draft-unreleased)",
  "type": "array",
  "maxItems": 20,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "version",
      "sha256",
      "summary",
      "platform",
      "verifiedBoundary",
      "views",
      "operations",
      "requiredCapabilities"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "version": {
        "type": "string",
        "minLength": 1
      },
      "sha256": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-f0-9]{64}$"
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "platform": {
        "type": "string",
        "minLength": 1
      },
      "verifiedBoundary": {
        "type": "string",
        "minLength": 1
      },
      "views": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "operations": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "requiredCapabilities": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
