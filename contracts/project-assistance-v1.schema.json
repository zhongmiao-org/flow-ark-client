{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "taskId": {
      "type": "string",
      "format": "uuid"
    },
    "reviewStamp": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operation": {
      "enum": [
        "generate",
        "assemble",
        "pause"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 200
      },
      "maxItems": 100,
      "default": []
    },
    "maxRequests": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20
    },
    "durationMs": {
      "type": "integer",
      "minimum": 10000,
      "maximum": 3600000,
      "default": 600000
    },
    "reviewedCost": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "taskId",
    "reviewStamp",
    "operation",
    "reviewedCost"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "generate"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "reviewedCost": {
            "const": true
          }
        }
      }
    }
  ]
}
