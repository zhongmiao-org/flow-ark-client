{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowark.local/contracts/run-output-packed-v1",
  "title": "RunOutputPackedV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "encoding", "runId", "expandedBytes", "sha256", "data"],
  "properties": {
    "version": { "const": 1 },
    "encoding": { "enum": ["deflate-raw-json-v1", "brotli-json-v1"] },
    "runId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "expandedBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "data": { "type": "string", "minLength": 4, "maxLength": 8388608, "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
  }
}
